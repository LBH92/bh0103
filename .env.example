# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Stock Data Source: "MOCK" for development, "REAL" for production
STOCK_DATA_SOURCE="REAL"

# Kiwoom Securities Open REST API (Server-side only, never exposed to client)
KIWOOM_IS_MOCK="false"
KIWOOM_APP_KEY="YOUR_KIWOOM_APP_KEY"
KIWOOM_APP_SECRET="YOUR_KIWOOM_APP_SECRET"

# Client environment variable for default source
VITE_STOCK_DATA_SOURCE="MOCK"
